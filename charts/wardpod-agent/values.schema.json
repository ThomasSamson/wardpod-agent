{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values du chart wardpod-agent",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nom du cluster déclaré dans la console."
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "serverURL": {
          "type": "string",
          "description": "Adresse du service Wardpod, en https://."
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "allowInsecure": {
          "type": "boolean"
        },
        "probePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "collect": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "auto",
            "operator",
            "builtin"
          ]
        },
        "internalGateways": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/[a-z0-9.-]+$"
          }
        },
        "internalGatewayClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inventory": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "scanner": {
      "type": "object",
      "properties": {
        "serverMatch": {
          "type": "boolean"
        },
        "registryAuth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": "string"
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "storageClass": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "existingClaim": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "description": "Autres réglages, variables WP_* de l'agent.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "shutdownTimeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
